{
  "private": true,
  "name": "hireos-monorepo",
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["saas/apps/*", "saas/packages/*"],
  "scripts": {
    "dev:web": "npm --workspace @hireos/web run dev",
    "dev:api": "npm --workspace @hireos/api run start:dev",
    "dev": "npm-run-all --parallel dev:web dev:api",
    "build": "npm --workspace @hireos/web run build && npm --workspace @hireos/api run build",
    "start": "npm --workspace @hireos/api run start",
    "lint": "npm --workspace @hireos/web run lint && npm --workspace @hireos/api run lint",
    "migrate": "npm --workspace @hireos/api run prisma:migrate",
    "prisma:generate": "npm --workspace @hireos/api run prisma generate",
    "test": "pwsh ./test.ps1"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "typescript": "^5.5.4"
  }
}
